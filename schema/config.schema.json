                    ],
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "openai": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "baseUrl": {
                    "type": "string",
                    "description": "override for self-hosted or compatible endpoints"
                  },
                  "maxTokens": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              },
              "gemini": {
                "type": "object",
                "properties": {
                  "model": {
